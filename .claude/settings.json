{
	"model": "fable",
	"effortLevel": "high",
	"remoteControlAtStartup": true,
	"attribution": {
		"sessionUrl": false
	},
	"outputStyle": "Concise",
	"permissions": {
		"defaultMode": "auto",
		"allow": [
			"Bash(docker:*)"
		]
	},
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "command -v afplay >/dev/null && afplay /System/Library/Sounds/Glass.aiff"
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "command -v afplay >/dev/null && afplay /System/Library/Sounds/Funk.aiff"
					}
				]
			}
		],
		"Notification": [
			{
				"matcher": "idle_prompt|agent_needs_input",
				"hooks": [
					{
						"type": "command",
						"command": "command -v afplay >/dev/null && afplay /System/Library/Sounds/Ping.aiff"
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"ponytail@ponytail": true,
		"i-have-adhd@i-have-adhd": true,
		"brand-skills@rylo-skills": true,
		"mobile-skills@rylo-skills": true,
		"finance-skills@rylo-skills": true,
		"regulatory-skills@rylo-skills": true,
		"data-skills@rylo-skills": true,
		"workflow-skills@rylo-skills": true,
		"research-skills@rylo-skills": true,
		"marketing-skills@rylo-skills": true
	},
	"extraKnownMarketplaces": {
		"rylo-skills": {
			"source": {
				"source": "github",
				"repo": "talknagish/rylo-skills"
			}
		},
		"ponytail": {
			"source": {
				"source": "github",
				"repo": "DietrichGebert/ponytail"
			}
		},
		"i-have-adhd": {
			"source": {
				"source": "github",
				"repo": "ayghri/i-have-adhd"
			}
		}
	},
	"promptSuggestionEnabled": false,
	"skipDangerousModePermissionPrompt": true,
	"statusLine": {
		"type": "command",
		"command": "bunx -y ccstatusline@latest",
		"padding": 0
	}
}
